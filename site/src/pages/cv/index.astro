---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHead from '../../components/SectionHead.astro';
import cv from '../../data/cv.yaml';
---

<BaseLayout
  title="Curriculum Vitae"
  description="Curriculum vitae of Dr. Maria Assumpta Komugabe — appointments, education, publications, service, and technical competencies."
>
  <div class="page-head">
    <p class="eyebrow">Curriculum Vitae</p>
    <h1>Curriculum Vitae</h1>
    <p class="lede">Maria Assumpta Komugabe, Ph.D. · Claremont, California · makomugabe@gmail.com</p>
    <div class="linkrow">
      <a href="mailto:makomugabe@gmail.com">Email</a>
      <a href="https://scholar.google.com/citations?user=8DhWmzAAAAAJ&hl=en">Google Scholar</a>
      <a href="https://orcid.org/0000-0001-5392-0300">ORCID</a>
    </div>
  </div>

  <SectionHead num="01" eyebrow="Positions" title="Academic Appointments" />
  <div class="prose">
    {cv.appointments.map((a) => (
      <div class="cv-entry">
        <div class="role">{a.role}</div>
        <div class="meta">{a.org} · {a.dates}</div>
      </div>
    ))}
  </div>

  <SectionHead num="02" eyebrow="Degrees" title="Education" />
  <div class="prose">
    {cv.education.map((e) => (
      <div class="cv-entry">
        <div class="role">{e.degree}</div>
        <div class="meta">{e.detail}</div>
      </div>
    ))}
  </div>

  <SectionHead num="03" eyebrow="Recognition" title="Honors & Awards" />
  <div class="prose">
    <ul>
      {cv.honors.map((h) => (
        <li><strong>{h.year}</strong> — {h.text}</li>
      ))}
    </ul>
  </div>

  <SectionHead num="04" eyebrow="Focus" title="Research Interests" />
  <div class="prose"><ul>{cv.interests.map((i) => <li>{i}</li>)}</ul></div>

  <SectionHead num="05" eyebrow="Scholarship" title="Publications" />
  <div class="prose">
    <p>
      {cv.publicationsSummary} <a href="/publications/">See the full, linked list on the Publications page →</a>
    </p>
  </div>

  <SectionHead num="06" eyebrow="Profession" title="Academic & Professional Service" />
  <div class="prose"><ul>{cv.service.map((s) => <li>{s}</li>)}</ul></div>

  <SectionHead num="07" eyebrow="Industry" title="Industry Experience" />
  <div class="prose">
    <div class="cv-entry">
      <div class="role">{cv.industry.role}</div>
      <div class="meta">{cv.industry.meta}</div>
    </div>
    <p>{cv.industry.description}</p>
  </div>

  <SectionHead num="08" eyebrow="Tools" title="Technical Competencies" />
  <div class="prose">
    {cv.skills.map((s) => (
      <div class="cv-entry">
        <div class="role">{s.area}</div>
        <div class="meta" style="text-transform:none">{s.list}</div>
      </div>
    ))}
  </div>
</BaseLayout>
